[Match]
Type=ether

[Network]
DHCP=yes
# Inert while "zeroconf" stays in DISTRO_FEATURES: that's what builds
# systemd with its own mdns responder off, leaving avahi the only one
# answering. Drop "zeroconf" and resolved starts answering on 5353 too.
MulticastDNS=yes

[DHCP]
UseDomains=yes
# Lower than wireless's RouteMetric: wired wins the default route when both are up.
RouteMetric=10
