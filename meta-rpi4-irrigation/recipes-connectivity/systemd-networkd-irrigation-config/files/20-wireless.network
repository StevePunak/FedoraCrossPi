[Match]
Type=wlan

[Network]
DHCP=yes
MulticastDNS=yes

[DHCP]
UseDomains=yes
# Higher than wired's RouteMetric: wireless loses the default route when both are up.
RouteMetric=20

# No RequiredForOnline=no here: wait-online runs with --any (10-any.conf),
# which ignores links not required for online, so a Wi-Fi-only boot would
# sit out the full 120s timeout before network-online.target.
